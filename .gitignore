# Python bytecode caches generated automatically when Python imports modules
__pycache__/

# pytest cache generated when running pytest
.pytest_cache/

# Jupyter notebook checkpoint files generated automatically by Jupyter
.ipynb_checkpoints/

# Python package/build metadata generated by pip, setuptools, or build tools
*.egg-info/
build/
dist/

# OS-specific metadata files generated by macOS or Windows
.DS_Store
Thumbs.db
